# Copy to .env and change the passwords. .env is git-ignored; never commit it.

# PostgreSQL (owner role: used by import, replay and risk scripts)
POSTGRES_USER=logistics
POSTGRES_PASSWORD=change_me_owner
POSTGRES_DB=logistics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read-only role used by the agent's tools
AGENT_RO_USER=agent_ro
AGENT_RO_PASSWORD=change_me_agent_ro

# Model (only needed for `make ask` and `make eval`; offline tests use a fake model)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# For LLM_PROVIDER=anthropic instead:
# Agent limits
AGENT_MAX_TOKENS_PER_CALL=1024
AGENT_MAX_TOKENS_PER_QUESTION=30000
AGENT_MODEL_TIMEOUT_SECONDS=30
